---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import TranslationCard from './TranslationCard.astro';

const translations = ((await getCollection('translation')) as CollectionEntry<'translation'>[])?.toSorted((a, b) => {
    const [yearA, yearB] = [a, b].map((x) => x.data.year ?? 0);
    if (yearA !== yearB) return yearB - yearA;
    return b.id.localeCompare(a.id);
});

interface Props {
    id: string;
}
const { id } = Astro.props;
---

<div>
    <h2 class="category-title" id={id}>Translations</h2>
    <ul class="translations-list">
        {
            translations.map((translation) => (
                <li class="translation-list-item">
                    <TranslationCard translation={translation} />
                </li>
            ))
        }
    </ul>
</div>

<style>
    .translations-list {
        display: grid;
        row-gap: var(--spacing-200);
    }

    @container style(--inline-size-s: var(--breakpoint-sm)) {
        .translations-list {
            row-gap: var(--spacing-300);
        }
    }
</style>
